<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/exo_position"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_seek_circle"
        android:padding="5dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout4"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/exo_duration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_seek_circle"
        android:padding="5dp"
        android:text="@string/app_name"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginEnd="15sp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout4"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="7dp"
            android:background="@drawable/selector_menu"
            android:focusable="true"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:focusableInTouchMode="true"
            android:padding="3dp"
            android:layout_marginTop="4dp"
            app:buffered_color="#F4A1A1"
            app:played_color="#FF2B3D"
            app:unplayed_color="#888888" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_seek_circle">

                <ImageView
                    android:id="@+id/player_speed"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/player_option_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="2dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/speed"
                    android:tint="#FFFFFF"
                    android:nextFocusDown="@id/playlistRecyclerView" />

                <ImageView
                    android:id="@+id/quality_btn"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/player_option_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="5dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/settings"
                    android:tint="#FFFFFF"
                    android:nextFocusDown="@id/playlistRecyclerView" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/prev_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="7dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_seek_circle">

                <ImageView
                    android:id="@+id/prev_icon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/player_option_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="7dp"
                    android:rotation="180"
                    android:src="@drawable/next"
                    android:tint="#FFFFFF" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/next_btn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="5dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_seek_circle">

                <ImageView
                    android:id="@+id/next_icon"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/player_option_selector"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:padding="7dp"
                    android:src="@drawable/next"
                    android:tint="#FFFFFF" />

            </LinearLayout>

        </LinearLayout>

        <ImageView
            android:id="@+id/playlist_arrow"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:rotation="90"
            android:tint="#FFFFFF"
            android:layout_marginBottom="10dp"
            android:visibility="gone"
            android:src="@drawable/arrow"/>

        <LinearLayout
            android:id="@+id/playlistLinear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:descendantFocusability="afterDescendants">

            <ScrollView
                android:id="@+id/seasonPlaylistScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="false"
                android:visibility="gone"
                android:descendantFocusability="afterDescendants">

                <LinearLayout
                    android:id="@+id/seasonPlaylistContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="12dp"
                    android:descendantFocusability="afterDescendants" />

            </ScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlistRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:descendantFocusability="afterDescendants" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:layout_marginStart="20dp"
        android:gravity="center"
        android:background="@drawable/bg_seek_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/movie_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:text="@string/app_name"/>

            <TextView
                android:id="@+id/movie_episode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:text="@string/app_name"/>
        </LinearLayout>

    </LinearLayout>

    <ImageView
        android:id="@+id/player_pause_play"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/btn_selector"
        android:focusable="true"
        android:padding="10dp"
        android:tint="#FFFFFF"
        android:src="@drawable/pause"
        android:focusableInTouchMode="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
